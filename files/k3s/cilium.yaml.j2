---
apiVersion: v1
kind: Namespace
metadata:
  name: cilium
  labels:
    name: cilium
---
# Installed by the k3s helm-controller. With bootstrap, the install job runs on
# the host network and tolerates NotReady nodes, so it works on a fresh cluster
# before any CNI exists (k3s runs with flannel-backend: none).
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: cilium
  namespace: kube-system
spec:
  bootstrap: true
  chart: cilium
  repo: https://helm.cilium.io/
  version: "{{ cilium_version }}"
  targetNamespace: cilium
  valuesContent: |-
    {{ cilium_values | to_nice_yaml(indent=2) | indent(4) }}
