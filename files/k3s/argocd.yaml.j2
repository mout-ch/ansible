---
apiVersion: v1
kind: Namespace
metadata:
  name: argocd
  labels:
    name: argocd
---
# ArgoCD is installed by k3s from here, not by an ArgoCD Application managing
# itself: bump argocd_chart_version in host_vars to upgrade it.
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: argocd
  namespace: kube-system
spec:
  chart: argo-cd
  repo: https://argoproj.github.io/argo-helm
  version: "{{ argocd_chart_version }}"
  targetNamespace: argocd
  valuesContent: |-
    {{ argocd_values | to_nice_yaml(indent=2) | indent(4) }}
